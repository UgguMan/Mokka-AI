PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/mokka_ai
# For Atlas, replace MONGODB_URI with your private mongodb+srv:// connection string.
# Google OAuth Web application client ID (not the Gemini API key). No client secret needed.
GOOGLE_CLIENT_ID=
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=25000
# Optional: override the project .venv Python executable
# PYTHON_PATH=C:/path/to/python.exe
